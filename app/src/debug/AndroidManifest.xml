<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application>
        <activity android:name="com.droidance.debug.TakeoverNavigationProbeActivity"
            android:exported="true" android:permission="android.permission.DUMP"
            android:taskAffinity="com.droidance.debug.takeovernavigation" />
        <activity android:name="com.droidance.debug.DisplayInsetsProbeActivity" android:exported="true" android:permission="android.permission.DUMP" android:taskAffinity="com.droidance.debug.insetsprobe" />
        <receiver android:name="com.droidance.debug.RegressionControlReceiver"
            android:exported="true" android:permission="android.permission.DUMP" />
        <activity android:name="com.droidance.debug.MascotGestureProbeActivity" android:exported="true" android:permission="android.permission.DUMP" />
        <activity android:name="com.droidance.debug.MascotPreviewActivity" android:exported="true" android:permission="android.permission.DUMP" />
        <activity android:name="com.droidance.debug.ObservationProbeActivity" android:exported="true" android:permission="android.permission.DUMP" />
        <!-- Repository instrumentation must not start application background work. -->
        <service android:name=".automation.NotificationWatcher" android:enabled="${repositoryBackgroundEnabled}" />
        <service android:name=".daemon.TaskExecutionService" android:enabled="${repositoryBackgroundEnabled}"
            android:foregroundServiceType="specialUse" />
        <service android:name=".daemon.KeepAliveJobService" android:enabled="${repositoryBackgroundEnabled}"
            tools:replace="android:enabled" />
        <receiver android:name=".daemon.BootReceiver" android:enabled="${repositoryBackgroundEnabled}" />
        <receiver android:name=".automation.AutomationAlarmReceiver" android:enabled="${repositoryBackgroundEnabled}" />
        <receiver android:name="com.droidance.core.device.air.AirModePairingReceiver" android:enabled="${repositoryBackgroundEnabled}" />
        <receiver android:name="com.droidance.core.device.agent.device.SidecarBinderReceiver" android:enabled="${repositoryBackgroundEnabled}" />
    </application>
</manifest>
