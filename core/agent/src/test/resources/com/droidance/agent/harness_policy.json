    "input_focus_probe_timeout_ms": 600,
    "foreground_package_cache_ttl_ms": 700,
    "route_attestation_attempts": 4,
    "route_attestation_delay_ms": 300,
    "route_attestation_timeout_ms": 8000,
    "pre_action_observation_mode": "enforce",
