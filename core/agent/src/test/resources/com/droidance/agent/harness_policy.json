  "observation_fingerprint": {
    "tool_receipt_markers": [
      "LOCAL_VALIDATION",
      "TEXT_INPUT",
      "INPUT_FOCUS",
      "PURE_VLM_SCREEN"
    ],
    "volatile_text_pattern": "\\d{1,2}:\\d{2}(?::\\d{2})?",
    "volatile_text_placeholder": "#t#"
  },
  "screen_action_batch": {
    "enabled": true,
    "allowed_operations": [
      "click",
      "type_text",
      "press_key",
      "scroll",
      "swipe",
      "drag",
      "path",
      "wait",
      "screenshot"
    ],
    "default_wait_ms": 1000,
    "min_wait_ms": 100,
    "max_wait_ms": 5000,
    "max_total_wait_ms": 5000,
    "max_capture_images": 10,
    "max_capture_bytes": 33554432,
    "max_drag_repeat": 64
  },
  "memory_context": {
    "core_profile_categories": [
      "identity",
      "communication",
      "language",
      "boundary",
      "preference",
      "personal_preference"
    ],
    "core_profile_max_items": 8,
    "related_memory_max_items": 6,
    "summary_max_chars": 240,
    "turn_index_max_chars": 2400,
    "skill_catalog_max_chars": 8000,
    "recall_detail_max_chars": 6000
  },
  "human_assistance": {
    "allowed_boundary_types": [
      "live_verification",
      "secret_credential",
      "payment_authorization",
      "irreversible_confirmation",
      "user_judgment"
    ],
    "recovery_handoffs": {
      "OBSERVATION_UNAVAILABLE": "observation_unavailable_handoff",
      "INPUT_PERMISSION_DENIED": "input_permission_denied_handoff"
    }
  },
  "tool_safety": {
    "confirmation_tools": [
      "send_sms",
      "make_call",
      "read_sms",
      "read_notifications",
      "set_alarm"
    ],
    "shell_destructive_patterns": [
      "(^|\\s)rm\\s+-",
      "(^|\\s)rm\\s+",
      "(^|\\s)mv\\s+",
      "(^|\\s)cp\\s+",
      "(^|\\s)dd\\s+",
      "(^|\\s)mkfs(\\s|$)",
      "(^|\\s)reboot(\\s|$)",
      "(^|\\s)shutdown(\\s|$)",
      "(^|\\s)locksettings\\s+",
      "(^|\\s)pm\\s+(uninstall|clear|disable|hide|suspend)\\s+",
      "(^|\\s)cmd\\s+(appops|deviceidle|package)\\s+.*\\b(set|uninstall|clear|disable|suspend)\\b",
      "(^|\\s)settings\\s+(put|delete)\\s+",
      "(^|\\s)content\\s+(insert|update|delete)\\s+",
      "(^|\\s)(kill|pkill|killall)\\s+",
      "(^|\\s)(chmod|chown|mount|umount|setenforce|iptables)\\s+"
    ],
    "shell_forbidden_patterns": [
      "uiautomator\\s+dump",
      "uiautomator\\s+runtest",
      "cat\\s+.*\\.xml",
      "cat\\s+/sdcard/ui",
      "(^|[\\s;&|(`])(cmd\\s+)?input\\s+(-d\\s+\\S+\\s+)?(tap|swipe|draganddrop|press|roll|keyevent|keycombination|text|motionevent|touchscreen|touchpad|touchnavigation|mouse|keyboard|gamepad|joystick|stylus|dpad|trackball|rotaryencoder)\\b",
      "(^|[\\s;&|(`])sendevent\\s+"
    ]
  },
  "vision_frame": {
    "max_long_edge": 2400,
    "max_pixels": 5000000,
    "jpeg_quality": 88
  },
  "virtual_space": {
    "render_wait_timeout_ms": 3000,
    "render_wait_poll_ms": 120,
    "sidecar_call_timeout_ms": 5000,
    "sidecar_capture_timeout_ms": 8000,
    "black_frame_mean_threshold": 8.0,
    "black_frame_variance_threshold": 6.0
  }
